{
  "name": "mermaid-studio-local",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "A local Mermaid renderer, optional flowchart layout editor, artifact store, and MCP gateway.",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "mcp": "tsx mcp/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "build:demo": "VITE_STATIC_DEMO=true VITE_BASE_PATH=/mermaid-studio-local/ VITE_OUT_DIR=dist-demo vite build",
    "start": "node dist/server/index.js",
    "start:mcp": "node dist/mcp/index.js",
    "native:viewer": "npm run build && swift run --package-path native/MermaidStudioViewer",
    "test": "npm run typecheck && npm run lint",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "test:native": "swift build --package-path native/MermaidStudioViewer && node scripts/native-lifecycle.mjs",
    "test:server": "node scripts/server-smoke.mjs",
    "test:copy": "node scripts/check-ui-copy.mjs",
    "test:demo": "npm run build:demo && node scripts/demo-smoke.mjs",
    "test:release": "npm run test && npm run build && npm run test:copy && npm run test:server && npm run test:browser && npm run test:mcp && npm run test:demo",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mermaid": "^11.12.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "playwright": "^1.54.2",
    "tsx": "^4.19.3",
    "typescript-eslint": "^8.43.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.7"
  }
}
